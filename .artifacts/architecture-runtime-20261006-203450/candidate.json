  "cards": [
    {
      "dot": "cyan",
      "title": "Shared domain, separate wire format",
      "items": [
        ":server compiles app/.../domain/ as an extra source directory",
        "Both modules use the same models; Dtos.kt and ApiMappers.kt keep the JSON contract separate on purpose"
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking integrity",
      "items": [
        "The slot_claims primary key is the double-booking guard, not application code",
        "Appointment, claim, and notification inserts share one db.tx, so all three land or none do"
      ]
    },
    {
      "dot": "amber",
      "title": "Known gaps",
      "items": [
        "AuthService.returnCodeToCaller is true: the OTP is printed to stdout and returned in the response body",
        "The access token is stored in plaintext SharedPreferences",
        "RegisterDetailsScreen keeps name and phone in local remember state and never calls /auth/register",
        "AppointmentDetailsScreen ignores the appointmentId from its route"
      ]
    }
  ]

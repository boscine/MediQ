  "cards": [
    {
      "dot": "emerald",
      "title": "Why slot_claims exists",
      "items": [
        "Double-booking protection is the database's job: one row per slot, enforced by its primary key",
        "A check-then-insert in application code has a window between the two statements, and both requests would pass",
        "Cancelling DELETEs the claim, which frees the slot; the appointment row is kept for history"
      ]
    },
    {
      "dot": "rose",
      "title": "The 409 a patient actually sees",
      "items": [
        "A violated constraint becomes 409 with ErrorDto(slot_taken, \"That time was just taken. Please pick another.\")",
        "call { } reads that body and throws ApiFailure, so BookingViewModel shows the server's own sentence",
        "Without that wrapper the patient would have read \"HTTP 409 \" from Retrofit's HttpException"
      ]
    }
  ]

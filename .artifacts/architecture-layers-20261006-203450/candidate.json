  "cards": [
    {
      "dot": "cyan",
      "title": "Why the split exists",
      "items": [
        "Repositories are the only layer that knows the data source; the compiler cannot catch ui/ importing data/",
        "domain/ stays plain Kotlin so :server can compile it as an extra source directory"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the guard catches",
      "items": [
        "Rule 1: domain-imports-android",
        "Rule 2: ui-imports-data — found 7 violations the first time it ran",
        "Rule 3: api-call-not-wrapped — this is the rule whose absence shipped a real bug on a fully green build"
      ]
    },
    {
      "dot": "amber",
      "title": "Not enforced",
      "items": [
        "There is no CI, so the script is run by hand",
        "A fourth rule on keyboardOptions is in the working copy but not committed, so it is not drawn here",
        "Exit code 2 means the script could not run and must never be read as clean"
      ]
    }
  ]
